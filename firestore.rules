rules_version = '2';

// Firestore security rules double as the database "hooks" for this app:
// every write is validated here regardless of what the client sends.
//
// Layout (all data is per-user, keyed by Firebase Auth uid):
//   users/{uid}                          profile + entry-number counter
//   users/{uid}/media/commission         commission image as a JPEG data URL
//   users/{uid}/credentials/{credId}     credential document METADATA
//   users/{uid}/transactions/{txId}      append-only notarial journal

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────── helpers ─────────────────────────
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function str(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function optStr(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max);
    }
    function optTs(d, k) { return !(k in d) || d[k] == null || d[k] is timestamp; }
    function changedOnly(keys) {
      return incoming().diff(existing()).affectedKeys().hasOnly(keys);
    }

    function actTypes() {
      return ['Acknowledgment', 'Jurat', 'Oath or Affirmation',
              'Copy Certification', 'Signature Witnessing', 'Other'];
    }
    function idMethods() {
      return ['Government-Issued Photo ID', 'Personally Known', 'Credible Witness', 'Other'];
    }
    function credentialTypes() { return ['commission', 'bond', 'insurance', 'training', 'other']; }

    // Optional signature: a PNG data URL from the on-screen signature pad.
    function validSignature(d) {
      return !('signature' in d) || d.signature == null
        || (d.signature is string
            && d.signature.size() <= 300000
            && d.signature.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$'));
    }

    // Everything not matched below is denied.
    match /{document=**} { allow read, write: if false; }

    // ───────────────────────── intakes/{token} ─────────────────────
    // Client intake links. The notary creates a request; the client, who is
    // not signed in, opens intake.html#<token> and submits once. The 40-hex
    // token is unguessable and is the only credential. No listing for the
    // public; reads by exact id only.
    match /intakes/{token} {
      function isIntakeOwner() { return signedIn() && existing().ownerUid == request.auth.uid; }
      function live() { return existing().status == 'pending' && existing().expiresAt > request.time; }
      function validIntakeCreate(d) {
        return d.keys().hasOnly(['ownerUid', 'notaryName', 'status', 'createdAt', 'expiresAt'])
          && d.ownerUid == request.auth.uid
          && d.status == 'pending'
          && d.createdAt is timestamp
          && d.expiresAt is timestamp
          && d.expiresAt <= request.time + duration.value(31, 'd')
          && optStr(d, 'notaryName', 200);
      }
      function validClientSubmit(d) {
        return d.status == 'submitted'
          && incoming().diff(existing()).affectedKeys().hasOnly([
               'status', 'submittedAt', 'clientName', 'clientAddress',
               'documentDescription', 'clientEmail', 'clientPhone', 'signature'])
          && d.submittedAt is timestamp
          && str(d.clientName, 200)
          && str(d.clientAddress, 500)
          && optStr(d, 'documentDescription', 500)
          && optStr(d, 'clientEmail', 254)
          && optStr(d, 'clientPhone', 40)
          && validSignature(d);
      }

      allow get: if true;
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && token.size() == 40 && validIntakeCreate(incoming());
      // Either the client submits (once, while the link is live) or the owner
      // closes the request. Nothing else changes.
      allow update: if (live() && validClientSubmit(incoming()))
        || (isIntakeOwner()
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            && incoming().status in ['used', 'cancelled']);
      allow delete: if isIntakeOwner();
    }

    // ───────────────────────── users/{uid} ─────────────────────
    match /users/{uid} {
      function validProfile(d) {
        return d.keys().hasOnly(['displayName', 'businessName', 'email', 'phone',
                                 'commissionState', 'commissionNumber',
                                 'nextEntryNumber', 'createdAt', 'updatedAt'])
          && d.nextEntryNumber is int && d.nextEntryNumber >= 1
          && d.createdAt is timestamp
          && optTs(d, 'updatedAt')
          && optStr(d, 'displayName', 200)
          && optStr(d, 'businessName', 200)
          && optStr(d, 'email', 254)
          && optStr(d, 'phone', 40)
          && optStr(d, 'commissionState', 60)
          && optStr(d, 'commissionNumber', 60);
      }

      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validProfile(incoming()) && incoming().nextEntryNumber == 1;
      // The counter may only stay put or advance by exactly one (journal insert).
      allow update: if isOwner(uid) && validProfile(incoming())
        && incoming().createdAt == existing().createdAt
        && (incoming().nextEntryNumber == existing().nextEntryNumber
            || incoming().nextEntryNumber == existing().nextEntryNumber + 1);
      allow delete: if false;

      // ─────────────────── media (commission image) ──────────────
      // Firebase Storage needs the Blaze plan, so the image lives here as a
      // client-shrunk JPEG data URL, capped well under the 1 MiB doc limit.
      match /media/{mediaId} {
        function validMedia(d) {
          return d.keys().hasOnly(['dataUrl', 'width', 'height', 'fileName', 'contentType', 'uploadedAt'])
            && d.dataUrl is string
            && d.dataUrl.size() <= 950000
            && d.dataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
            && d.contentType == 'image/jpeg'
            && d.width is int && d.width > 0 && d.width <= 10000
            && d.height is int && d.height > 0 && d.height <= 10000
            && d.uploadedAt is timestamp
            && optStr(d, 'fileName', 255);
        }
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && mediaId == 'commission' && validMedia(incoming());
        allow delete: if isOwner(uid);
      }

      // ─────────────────── credentials (metadata only) ───────────
      match /credentials/{credId} {
        function validCredential(d) {
          return d.keys().hasOnly(['type', 'label', 'fileUrl', 'fileName',
                                   'uploadedAt', 'expiresAt', 'notes', 'createdAt'])
            && d.type in credentialTypes()
            && str(d.label, 200)
            && d.uploadedAt is timestamp
            && d.expiresAt is timestamp
            && d.expiresAt > d.uploadedAt
            && d.createdAt is timestamp
            && optStr(d, 'fileUrl', 2000)
            && optStr(d, 'fileName', 255)
            && optStr(d, 'notes', 2000);
        }
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validCredential(incoming());
        allow update: if isOwner(uid) && validCredential(incoming())
          && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(uid);
      }

      // ─────────────────── transactions (append-only) ────────────
      match /transactions/{txId} {
        function validTransaction(d) {
          return d.keys().hasOnly(['entryNumber', 'actDate', 'actType', 'clientName',
                                   'clientAddress', 'clientEmail', 'clientPhone',
                                   'idMethod', 'fee', 'documentDescription', 'notes',
                                   'signature', 'intakeId', 'voided', 'voidReason', 'createdAt', 'updatedAt'])
            && d.entryNumber is int && d.entryNumber >= 1
            && d.actDate is timestamp
            && d.actDate <= request.time + duration.value(5, 'm')
            && d.actType in actTypes()
            && str(d.clientName, 200)
            && str(d.clientAddress, 500)
            && d.idMethod in idMethods()
            && d.fee is number && d.fee >= 0 && d.fee <= 100000
            && d.voided is bool
            && d.createdAt is timestamp
            && optTs(d, 'updatedAt')
            && optStr(d, 'clientEmail', 254)
            && optStr(d, 'clientPhone', 40)
            && optStr(d, 'documentDescription', 500)
            && optStr(d, 'notes', 4000)
            && optStr(d, 'voidReason', 500)
            && optStr(d, 'intakeId', 64)
            && validSignature(d);
        }

        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validTransaction(incoming()) && incoming().voided == false;
        // Only notes, contact details and the void flag may change after insert.
        // Voiding is one-way and requires a reason. Nothing is ever deleted.
        allow update: if isOwner(uid) && validTransaction(incoming())
          && changedOnly(['notes', 'clientEmail', 'clientPhone', 'voided', 'voidReason', 'updatedAt'])
          && (existing().voided == false || incoming().voided == true)
          && (incoming().voided == existing().voided || str(incoming().voidReason, 500));
        allow delete: if false;
      }
    }
  }
}
